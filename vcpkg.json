{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "dependencies": [
    "stb",
    "nlohmann-json",
    "cppzmq",
    "readerwriterqueue",
    "cxxopts",
    "boost-stacktrace",
    "boost-uuid",
    "boost-random",
    "mosquitto",
    "ms-gsl",
    "fmt",
    {
      "name": "spdlog",
      "version>=": "1.16.0"
    },
    {
      "name": "drogon",
      "version>=": "1.9.13"
    },
    {
      "name": "protobuf",
      "version>=": "5.29.5#3"
    },
    {
      "name": "cpr",
      "default-features": false
    },
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "gnutls",
        "http2",
        "non-http"
      ]
    }
  ],
  "overrides": [
    {
      "name": "libgnutls",
      "version": "3.7.8"
    }
  ],
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "version": "0.0.2",
  "name": "matrix-pipeline"
}